# Профиль AppArmor контейнера orbit session: профиль Docker по умолчанию, в котором вместо запрета `mount` разрешено
# монтирование FUSE. Агент монтирует файловую систему сам через mount(2), без fusermount.
#
# Загрузка на хосте с AppArmor (имя профиля передаётся шаблону server как `apparmor=iapetus-session`):
#   sudo apparmor_parser -r -W docker/apparmor/iapetus-session
#   docker run --security-opt apparmor=iapetus-session ...

#include <tunables/global>

profile iapetus-session flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Монтирование только FUSE: другие файловые системы, bind, move и remount остаются запрещены.
  mount fstype=fuse,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=iapetus-session,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=iapetus-session,
}
